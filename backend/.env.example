# development | test | production. Em production o backend recusa o JWT secret padrão e CORS "*".
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8787
BACKEND_JWT_SECRET=change-me-in-production
BACKEND_ACCESS_TOKEN_TTL_SECONDS=3600
BACKEND_RATE_LIMIT_MAX=100
BACKEND_RATE_LIMIT_WINDOW=1 minute
# Limite próprio do endpoint de geração cinematográfica (consome cota paga do provedor).
BACKEND_CINEMATIC_RATE_LIMIT_MAX=5
BACKEND_CINEMATIC_RATE_LIMIT_WINDOW=1 hour
# true quando o backend roda atrás de proxy/load balancer (usa X-Forwarded-For para o IP do cliente).
BACKEND_TRUST_PROXY=false
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_DATA_FILE=backend/data/store.json
# Opcional: sem chave, o endpoint cinematográfico responde 503.
BACKEND_GEMINI_API_KEY=
BACKEND_ADMIN_EMAIL=admin@gesturestrike.dev
BACKEND_ADMIN_PASSWORD=ChangeMe123!
